{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["local>ckoliber/dotfiles"],
  "packageRules": [
    {
      "description": "Group all Go updates together",
      "matchManagers": ["mise", "gomod"],
      "matchDepNames": ["go", "golang"],
      "rangeStrategy": "bump",
      "groupName": "Go updates"
    },
    {
      "description": "Disable updates for gocrud package",
      "matchPackageNames": ["**/gocrud"],
      "enabled": false
    }
  ]
}
